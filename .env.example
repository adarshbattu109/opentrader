# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; this file is committed and must never hold a secret.
#
# POC scope: nothing here is needed for backtesting -- `uv run python -m
# opentrader.backtest strategies/ema_cross.json` works with no credentials at
# all, because tvdatafeed reads public data anonymously. These only matter for
# the live paper leg (§4 step 5).

# --- tvdatafeed (optional) ---------------------------------------------------
# Anonymous access works but is rate-limited and caps intraday history. A free
# TradingView account raises both limits. Leave blank to stay anonymous.
TV_USERNAME=
TV_PASSWORD=

# --- Broker live/paper feed (needed only for live_paper.py) ------------------
# Pick ONE broker and fill in its block. Dhan and Fyers both offer a free live
# feed; see design doc §10.2 for the package per broker.
BROKER=dhan

# Dhan -- https://dhanhq.co/ -> Profile -> DhanHQ Trading APIs -> generate token.
# Access token is valid ~24h unless you request a longer-lived one.
# DHAN_SECURITY_ID is the numeric instrument id, NOT the ticker: look it up in
# Dhan's scrip master CSV (RELIANCE on NSE_EQ is 2885). The automatic
# symbol -> security_id lookup is the instrument master, a v1 component (§11.9).
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_SECURITY_ID=

# Fyers -- https://myapi.fyers.in/ -> create an app to get id/secret.
# FYERS_ACCESS_TOKEN is obtained per-day via the OAuth redirect flow.
FYERS_APP_ID=
FYERS_SECRET_ID=
FYERS_ACCESS_TOKEN=

# --- Notes -------------------------------------------------------------------
# SEBI requires static-IP whitelisting and Algo-ID order tagging for API order
# placement (design doc §11.6-11.8). Neither applies while orders stay mock --
# the POC never sends an order to an exchange. Both become mandatory at the
# first real order, which is a v1 concern.
